// pages/sweep-word-motion.js: the custom properties src/lyrics/lyricAnimator.ts writes on one `.word`
// (data-s .100, data-e .600: harness timing) as the page's clock runs, one row per 1/60 s step:
// row i = the unit's --gp / --gb / --go after collectLine and stepLine(words, k / 60, 1 / 60) for k = 0..i
// (null = not set). The GPUI scene (src-gpui/src/primitives.rs, SweepMotion) steps the Rust port the same way.
// Run: node scripts/primitives/gen-sweep-motion.mts
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { collectLine, stepLine } from "../../src/lyrics/lyricAnimator.ts";

// the case's frames (cases.json sweep-word-motion: 30 frames of two steps) and a margin
const STEPS = 64;

function fakeEl(classes: string[], dataset: Record<string, string>, children: any[] = []): any {
  const props = new Map<string, string>();
  return {
    classList: { contains: (c: string) => classes.includes(c) },
    dataset: { ...dataset },
    style: { props, setProperty: (p: string, v: string) => void props.set(p, v), removeProperty: (p: string) => void props.delete(p) },
    children,
    querySelectorAll(sel: string) {
      const want = sel.split(",").map((s) => s.trim().replace(/^\./, ""));
      return children.filter((c) => want.some((w) => c.classList.contains(w)));
    },
  };
}

const unit = fakeEl(["word"], { s: "0.100", e: "0.600" });
const words = collectLine(fakeEl(["lyric-line"], {}, [unit]));
const rows: Record<string, string | null>[] = [];
for (let k = 0; k <= STEPS; k++) {
  stepLine(words, k / 60, 1 / 60);
  const p = unit.style.props as Map<string, string>;
  rows.push({ gp: p.get("--gp") ?? null, gb: p.get("--gb") ?? null, go: p.get("--go") ?? null });
}
const out = path.join(path.dirname(fileURLToPath(import.meta.url)), "pages", "sweep-word-motion.js");
fs.writeFileSync(out, `// generated by scripts/primitives/gen-sweep-motion.mts\nvar SWEEP_MOTION = ${JSON.stringify(rows)};\n`);
console.log(`${out}: ${rows.length} rows`);
