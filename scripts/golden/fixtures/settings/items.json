 "fmts": {
  "FmtOffset": {
   "ts": "fmtOffset",
   "js": "((v) => (v === 0 ? \"in sync\" : `${v > 0 ? \"+\" : \"\"}${v.toFixed(1)}s`))"
  },
  "AutoSync": {
   "ts": "(v) => (v ? `after ${v}s` : \"off\")",
   "js": "((v) => (v ? `after ${v}s` : \"off\"))"
  },
  "FollowSpeed": {
   "ts": "(v) => `${v} ms`",
   "js": "((v) => `${v} ms`)"
  },
  "ScrollSpeed": {
   "ts": "(v) => `${v}×`",
   "js": "((v) => `${v}×`)"
  },
  "PanelHeight": {
   "ts": "(v) => `${v}px`",
   "js": "((v) => `${v}px`)"
  },
  "LineHeight": {
   "ts": "(v) => v.toFixed(2)",
   "js": "((v) => v.toFixed(2))"
  },
  "LetterSpacing": {
   "ts": "(v) => (v ? `${v > 0 ? \"+\" : \"\"}${v.toFixed(2)}em` : \"normal\")",
   "js": "((v) => (v ? `${v > 0 ? \"+\" : \"\"}${v.toFixed(2)}em` : \"normal\"))"
  },
  "RainbowSpeed": {
   "ts": "(v) => `${v}s`",
   "js": "((v) => `${v}s`)"
  },
  "Times": {
   "ts": "times",
   "js": "((v) => `${Math.round(v * 100)}%`)"
  },
  "Pct": {
   "ts": "pct",
   "js": "((v) => `${Math.round(v)}%`)"
  },
  "BgAlpha": {
   "ts": "(v) => `${v}%${v === 0 ? \" · clear\" : v === 100 ? \" · solid\" : v === DEFAULTS.bgAlpha ? \" · default\" : \"\"}`",
   "js": "((v) => `${v}%${v === 0 ? \" · clear\" : v === 100 ? \" · solid\" : v === DEFAULTS.bgAlpha ? \" · default\" : \"\"}`)"
  },
  "PanSpeed": {
   "ts": "(v) => `${v} px/s`",
   "js": "((v) => `${v} px/s`)"
  },
  "BarThickness": {
   "ts": "(v) => `${v + 2}px`",
   "js": "((v) => `${v + 2}px`)"
  }
 },
