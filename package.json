{
  "name": "playback",
  "private": true,
  "version": "1.4.3",
  "description": "Now-playing overlay with synced lyrics",
  "author": "Playback",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test tests/spicy.test.cjs tests/spotifyLookup.test.cjs tests/spicetifySetup.test.cjs",
    "test:layout": "npm run build && electron --in-process-gpu --disable-gpu tests/lyrics-layout.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "app": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "npm run build && electron .",
    "icon": "electron scripts/make-icon.cjs",
    "pack:app": "node scripts/pack.cjs",
    "package": "npm run build && npm run pack:app && electron-builder --win nsis-web --prepackaged release/Playback-win32-x64 --publish never",
    "installer": "npm --prefix installer run build"
  },
  "build": {
    "appId": "com.player.smtcwidget",
    "productName": "Playback",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "spicetify/player-bridge.js",
      "package.json"
    ],
    "asarUnpack": [
      "electron/smtc.ps1"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dev-avs",
        "repo": "playback"
      }
    ],
    "win": {
      "target": "nsis-web"
    },
    "nsisWeb": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "playback-setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lucide-react": "^1.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
